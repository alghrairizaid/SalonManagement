extends ../layouts/main

block content
  h1.mb-4 Our Services
  p.lead.mb-5 Choose from our wide range of professional manicure services
  
  .row
    if services && services.length > 0
      each service in services
        .col-md-4.mb-4
          .card.service-card.h-100.bg-dark
            if service.image
              img.card-img-top(src=service.image, alt=service.name)
            else
              .card-img-top.d-flex.align-items-center.justify-content-center.bg-secondary(style="height: 200px;")
                i.fas.fa-spa.fa-4x.text-light
            
            .card-body
              h3.card-title= service.name
              p.card-text= service.description ? service.description.substring(0, 100) + (service.description.length > 100 ? '...' : '') : 'No description available'
              
              .d-flex.justify-content-between.align-items-center.mt-3
                .price
                  span.text-primary $#{service.price.toFixed(2)}
                  small.text-muted.ms-2 #{service.duration} min
                
                if user && user.role === 'client'
                  a.btn.btn-outline-primary(href=`/appointments/book?service=${service.id}`) Book Now
                else
                  a.btn.btn-outline-info(href=`/services/${service.id}`) View Details
            
            if user && user.role === 'admin'
              .card-footer.bg-dark.border-top
                .d-flex.justify-content-between
                  a.btn.btn-sm.btn-info(href=`/admin/services/edit/${service.id}`)
                    i.fas.fa-edit.me-1
                    | Edit
                  a.btn.btn-sm.btn-danger.delete-btn(href=`/admin/services/delete/${service.id}`)
                    i.fas.fa-trash.me-1
                    | Delete
    else
      .col-12
        .alert.alert-info.text-center
          i.fas.fa-info-circle.fa-2x.mb-3.d-block
          p.lead No services are currently available.
          if user && user.role === 'admin'
            a.btn.btn-primary.mt-2(href="/admin/services/add") Add a New Service
  
  if user && user.role === 'client'
    .card.bg-dark.mt-4
      .card-body
        .row.align-items-center
          .col-md-8
            h3 Ready to book your appointment?
            p Choose your preferred service and schedule a time that works for you.
          .col-md-4.text-md-end.mt-3.mt-md-0
            a.btn.btn-lg.btn-primary(href="/appointments/book")
              i.fas.fa-calendar-plus.me-2
              | Book Now
