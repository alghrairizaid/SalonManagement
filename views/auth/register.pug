extends ../layouts/main

block content
  .row.justify-content-center
    .col-md-6
      .card.bg-dark
        .card-header
          h3.text-center Register
        .card-body
          form(action="/register", method="POST")
            .mb-3
              label.form-label(for="name") Full Name
              input#name.form-control(type="text", name="name", placeholder="Enter your full name", value=name || "", required)
            
            .mb-3
              label.form-label(for="email") Email
              input#email.form-control(type="email", name="email", placeholder="Enter your email", value=email || "", required)
            
            .mb-3
              label.form-label(for="phone") Phone (optional)
              input#phone.form-control(type="tel", name="phone", placeholder="Enter your phone number", value=phone || "")
            
            .mb-3
              label.form-label(for="role") Account Type
              select#role.form-control(name="role", required)
                option(value="client" selected) Client
                option(value="manicurist") Manicurist
            
            .mb-3
              label.form-label(for="password") Password
              input#password.form-control(type="password", name="password", placeholder="Create a password", required)
              small.form-text.text-muted Password must be at least 6 characters
            
            .mb-3
              label.form-label(for="password2") Confirm Password
              input#password2.form-control(type="password", name="password2", placeholder="Confirm your password", required)
            
            button.btn.btn-primary.w-100.mb-3(type="submit") Register
          
          hr
          
          p.text-center Already have an account? 
            a(href="/login") Login here
