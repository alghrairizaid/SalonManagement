extends ../layouts/main

block content
  h1.mb-4 Admin Dashboard
  
  // Stats Row
  .row.mb-5
    .col-md-3.mb-3
      .stat-card
        i.fas.fa-calendar-check.text-primary
        h3 Appointments
        .stat-number= appointments.length
        p Total Upcoming
    
    .col-md-3.mb-3
      .stat-card
        i.fas.fa-users.text-success
        h3 Clients
        .stat-number= clientCount
        p Registered
    
    .col-md-3.mb-3
      .stat-card
        i.fas.fa-user-md.text-info
        h3 Manicurists
        .stat-number= manicuristCount
        p Active
    
    .col-md-3.mb-3
      .stat-card
        i.fas.fa-spa.text-warning
        h3 Services
        .stat-number= serviceCount
        p Available
  
  .row
    // Upcoming Appointments
    .col-lg-8
      .card.bg-dark.mb-4
        .card-header.d-flex.justify-content-between.align-items-center
          h3.mb-0 Upcoming Appointments
          a.btn.btn-primary.btn-sm(href="/appointments") View All
        .card-body
          if appointments && appointments.length > 0
            table.table.table-dark
              thead
                tr
                  th Date & Time
                  th Client
                  th Manicurist
                  th Service
                  th Status
                  th Actions
              tbody
                each appointment in appointments
                  tr
                    td= new Date(appointment.appointment_date).toLocaleString()
                    td= appointment.client_name
                    td= appointment.manicurist_name
                    td= appointment.service_name
                    td
                      span.badge(class=`status-${appointment.status}`)= appointment.status
                    td
                      a.btn.btn-sm.btn-info(href=`/appointments/${appointment.id}`) 
                        i.fas.fa-eye
          else
            p.text-center.py-3 No upcoming appointments
    
    // Quick Links
    .col-lg-4
      .card.bg-dark.mb-4
        .card-header
          h3.mb-0 Quick Links
        .card.body.p-3
          .list-group.list-group-flush.bg-dark
            a.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center.bg-dark(href="/admin/manicurists")
              div
                i.fas.fa-user-md.me-2.text-info
                | Manage Manicurists
              i.fas.fa-chevron-right
            
            a.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center.bg-dark(href="/admin/services")
              div
                i.fas.fa-spa.me-2.text-warning
                | Manage Services
              i.fas.fa-chevron-right
            
            a.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center.bg-dark(href="/appointments")
              div
                i.fas.fa-calendar-alt.me-2.text-primary
                | Appointment Schedule
              i.fas.fa-chevron-right
            
            a.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center.bg-dark(href="/services")
              div
                i.fas.fa-list.me-2.text-success
                | View Services Catalog
              i.fas.fa-chevron-right
            
            a.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center.bg-dark(href="/admin/clients")
              div
                i.fas.fa-users.me-2.text-primary
                | Manage Clients
              i.fas.fa-chevron-right
      
      // System Status
      .card.bg-dark.mb-4
        .card-header
          h3.mb-0 System Status
        .card-body
          ul.list-unstyled
            li.mb-3
              i.fas.fa-database.me-2.text-success
              | Database: 
              span.badge.bg-success Online
            
            li.mb-3
              i.fas.fa-server.me-2.text-success
              | Server: 
              span.badge.bg-success Running
            
            li.mb-3
              i.fas.fa-user-shield.me-2.text-success
              | Admin Access: 
              span.badge.bg-success Active
