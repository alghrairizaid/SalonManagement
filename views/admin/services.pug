extends ../layouts/main

block content
  h1.mb-4 Manage Services
  
  if showAddForm
    // Add Service Form
    .card.bg-dark.mb-4
      .card-header
        h3.mb-0 Add New Service
      .card-body
        form(action="/admin/services/add", method="POST")
          .row
            .col-md-6.mb-3
              label.form-label(for="name") Service Name
              input#name.form-control(type="text", name="name", required, value=serviceData && serviceData.name ? serviceData.name : '')
            
            .col-md-6.mb-3
              label.form-label(for="duration") Duration (minutes)
              input#duration.form-control(type="number", name="duration", min="5", step="5", required, value=serviceData && serviceData.duration ? serviceData.duration : 30)
          
          .row
            .col-md-6.mb-3
              label.form-label(for="price") Price ($)
              input#price.form-control(type="number", name="price", min="0", step="0.01", required, value=serviceData && serviceData.price ? serviceData.price : '')
            
            .col-md-6.mb-3
              label.form-label(for="image") Image URL (optional)
              input#image.form-control(type="text", name="image", value=serviceData && serviceData.image ? serviceData.image : '')
          
          .mb-3
            label.form-label(for="description") Description
            textarea#description.form-control(name="description", rows="3")= serviceData && serviceData.description ? serviceData.description : ''
          
          .d-flex
            button.btn.btn-primary.me-2(type="submit") Add Service
            a.btn.btn-secondary(href="/admin/services") Cancel
  
  else if showEditForm && service
    // Edit Service Form
    .card.bg-dark.mb-4
      .card-header
        h3.mb-0 Edit Service
      .card-body
        form(action=`/admin/services/edit/${service.id}`, method="POST")
          .row
            .col-md-6.mb-3
              label.form-label(for="name") Service Name
              input#name.form-control(type="text", name="name", required, value=service.name)
            
            .col-md-6.mb-3
              label.form-label(for="duration") Duration (minutes)
              input#duration.form-control(type="number", name="duration", min="5", step="5", required, value=service.duration)
          
          .row
            .col-md-6.mb-3
              label.form-label(for="price") Price ($)
              input#price.form-control(type="number", name="price", min="0", step="0.01", required, value=service.price)
            
            .col-md-6.mb-3
              label.form-label(for="image") Image URL (optional)
              input#image.form-control(type="text", name="image", value=service.image || '')
          
          .mb-3
            label.form-label(for="description") Description
            textarea#description.form-control(name="description", rows="3")= service.description || ''
          
          .d-flex
            button.btn.btn-primary.me-2(type="submit") Update Service
            a.btn.btn-secondary(href="/admin/services") Cancel
  
  else
    // Service List
    .d-flex.justify-content-between.align-items-center.mb-4
      h2.mb-0 Service List
      a.btn.btn-primary(href="/admin/services/add")
        i.fas.fa-plus.me-1
        | Add New Service
    
    .card.bg-dark
      .card-body
        if services && services.length > 0
          .table-responsive
            table.table.table-dark
              thead
                tr
                  th Service Name
                  th Duration
                  th Price
                  th Actions
              tbody
                each service in services
                  tr
                    td= service.name
                    td= service.duration + ' min'
                    td $#{service.price.toFixed(2)}
                    td
                      a.btn.btn-info.btn-sm.me-1(href=`/admin/services/edit/${service.id}`)
                        i.fas.fa-edit
                      a.btn.btn-danger.btn-sm.delete-btn(href=`/admin/services/delete/${service.id}`)
                        i.fas.fa-trash
        else
          p.text-center.py-3 No services found. 
            a(href="/admin/services/add") Add a service
