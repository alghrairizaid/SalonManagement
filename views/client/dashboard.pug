extends ../layouts/main

block content
  h1.mb-4 Client Dashboard
  p.lead Welcome back, #{user.name}!
  
  .row
    .col-lg-8
      // Upcoming Appointments
      .card.bg-dark.mb-4
        .card-header.d-flex.justify-content-between.align-items-center
          h3.mb-0 Your Upcoming Appointments
          a.btn.btn-primary.btn-sm(href="/client/history") View All
        .card-body
          if upcomingAppointments && upcomingAppointments.length > 0
            ul.list-group.list-group-flush.bg-dark
              each appointment in upcomingAppointments
                li.list-group-item.bg-dark.mb-3.appointment-item
                  .d-flex.justify-content-between.align-items-start
                    div
                      h5.mb-1= appointment.service_name
                      p.mb-1
                        i.fas.fa-calendar-alt.me-2
                        = new Date(appointment.appointment_date).toLocaleString()
                      p.mb-1
                        i.fas.fa-user.me-2
                        | Manicurist: #{appointment.manicurist_name}
                      span.badge(class=`status-${appointment.status}`)= appointment.status
                    div
                      a.btn.btn-outline-info.mb-2.w-100(href=`/client/appointments/${appointment.id}`)
                        i.fas.fa-eye.me-1
                        | Details
                      if appointment.status !== 'cancelled' && appointment.status !== 'completed'
                        a.btn.btn-outline-danger.w-100.cancel-appointment-btn(href=`/client/appointments/${appointment.id}/cancel`)
                          i.fas.fa-times.me-1
                          | Cancel
          else
            .text-center.py-4
              i.fas.fa-calendar-alt.fa-3x.mb-3.text-muted
              p.lead No upcoming appointments
              a.btn.btn-primary.mt-2(href="/appointments/book") Book an Appointment
      
      // Our Services Promo
      .card.bg-dark.mb-4
        .card-header
          h3.mb-0 Our Services
        .card-body
          .row
            .col-md-4.mb-3
              .card.h-100.bg-dark
                .card-body.text-center
                  i.fas.fa-paint-brush.fa-3x.mb-3.text-primary
                  h4 Classic Manicure
                  p Starting at $25
            
            .col-md-4.mb-3
              .card.h-100.bg-dark
                .card-body.text-center
                  i.fas.fa-magic.fa-3x.mb-3.text-success
                  h4 Gel Manicure
                  p Starting at $35
            
            .col-md-4.mb-3
              .card.h-100.bg-dark
                .card-body.text-center
                  i.fas.fa-gem.fa-3x.mb-3.text-info
                  h4 Nail Art
                  p Starting at $15
          
          .text-center.mt-3
            a.btn.btn-outline-primary(href="/services") View All Services
    
    .col-lg-4
      // Quick Actions
      .card.bg-dark.mb-4
        .card-header
          h3.mb-0 Quick Actions
        .card-body.p-0
          .list-group.list-group-flush
            a.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center.bg-dark(href="/appointments/book")
              div
                i.fas.fa-calendar-plus.me-2.text-primary
                | Book Appointment
              i.fas.fa-chevron-right
            
            a.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center.bg-dark(href="/client/history")
              div
                i.fas.fa-history.me-2.text-info
                | Appointment History
              i.fas.fa-chevron-right
            
            a.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center.bg-dark(href="/client/profile")
              div
                i.fas.fa-user.me-2.text-success
                | Update Profile
              i.fas.fa-chevron-right
            
            a.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center.bg-dark(href="/services")
              div
                i.fas.fa-spa.me-2.text-warning
                | Browse Services
              i.fas.fa-chevron-right
      
      // Account Info
      .card.bg-dark
        .card-header
          h3.mb-0 Account Info
        .card-body
          .d-flex.justify-content-center.mb-4
            .avatar-placeholder.bg-primary.rounded-circle.d-flex.justify-content-center.align-items-center(style="width: 100px; height: 100px;")
              i.fas.fa-user.fa-3x.text-light
          
          ul.list-group.list-group-flush.bg-dark
            li.list-group-item.bg-dark
              strong Name: 
              = user.name
            
            li.list-group-item.bg-dark
              strong Email: 
              = user.email
            
            li.list-group-item.bg-dark
              strong Phone: 
              = user.phone || 'Not provided'
            
            li.list-group-item.bg-dark
              strong Member Since: 
              = new Date(user.created_at).toLocaleDateString()
